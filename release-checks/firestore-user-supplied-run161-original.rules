rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function owner(id) { return loggedIn() && request.auth.uid == id; }
    function verified() { return loggedIn() && request.auth.token.email_verified == true; }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['alias', 'publicStats', 'learned', 'updatedAt'])
        && request.resource.data.keys().hasAll(['alias', 'publicStats', 'learned', 'updatedAt'])
        && request.resource.data.alias is string
        && request.resource.data.alias.size() >= 2 && request.resource.data.alias.size() <= 40
        && request.resource.data.publicStats is bool
        && request.resource.data.learned is int
        && request.resource.data.learned >= 0 && request.resource.data.learned <= 1000000
        && request.resource.data.updatedAt is int;
    }
    match /users/{userId} {
      allow get: if owner(userId) || (loggedIn() && resource.data.publicStats == true);
      allow list: if loggedIn() && resource.data.publicStats == true;
      allow create, update: if owner(userId) && verified() && validProfile();
      allow delete: if owner(userId);
    }
    function validLibrary() {
      return request.resource.data.keys().hasOnly(['ownerUid','ownerName','title','category','count','sheetId','visibility','updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid','ownerName','title','category','count','sheetId','visibility','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.category is string && request.resource.data.category.size() <= 90
        && request.resource.data.count is int && request.resource.data.count >= 0 && request.resource.data.count <= 3000
        && request.resource.data.sheetId is string && request.resource.data.sheetId.size() >= 20 && request.resource.data.sheetId.size() <= 200
        && request.resource.data.visibility in ['public','private']
        && request.resource.data.updatedAt is int;
    }

    // Private preferences are readable and writable only by this Firebase UID.
    function validSettings() {
      return request.resource.data.keys().hasOnly(['scope','subscriptions','updatedAt'])
        && request.resource.data.keys().hasAll(['scope','subscriptions','updatedAt'])
        && request.resource.data.scope in ['all','mine']
        && request.resource.data.subscriptions is string
        && request.resource.data.subscriptions.size() <= 40000
        && request.resource.data.updatedAt is int;
    }
    match /settings/{userId} {
      allow get: if owner(userId);
      allow list: if false;
      allow create, update: if owner(userId) && verified() && validSettings();
      allow delete: if owner(userId);
    }
// PILOT: INSERT THIS BLOCK BEFORE existing match /{document=**} IN YOUR FIRESTORE RULES.
// Only adds sync_v3. DO NOT replace any existing users/settings/libraries rules.
    function v3SignedIn() {
      return request.auth != null;
    }
    function v3Owner(uid) {
      return v3SignedIn() && request.auth.uid == uid;
    }
    function validPayload() {
      let k = request.resource.data.kind;
      let d = request.resource.data.data;
      return (
        (k == 'answer' && d.keys().hasOnly(['correct','reviewLearned']) &&
         d.keys().hasAll(['correct']) && d.correct is bool &&
         (!d.keys().hasAny(['reviewLearned']) || d.reviewLearned is bool))
        ||
        (k == 'learned_set' && d.keys().hasOnly(['learned']) &&
         d.learned is bool)
        ||
        (k == 'favorite_set' && d.keys().hasOnly(['starred']) &&
         d.starred is bool)
        ||
        (k == 'word_delete' && d.keys().hasOnly(['deleted']) &&
         d.deleted == true)
        ||
        // NEW V3: verified owner's private My Finds, safely scoped to study IDs.
        (k == 'collection_set' &&
         request.auth.token.email_verified == true &&
         (request.resource.data.target.matches('^[TMPH][0-9]{5,7}$') ||
          request.resource.data.target.matches('^W_[a-f0-9]{32}$')) &&
         d.keys().hasOnly(['list','added','topic','note']) &&
         d.keys().hasAll(['list','added','topic','note']) &&
         d.list == 'finds' && d.added is bool &&
         d.topic in ['practice','study','other'] &&
         d.note is string && d.note.size() <= 350)
        ||
        (k == 'word_upsert' && d.keys().size() <= 24 &&
         d.keys().hasAll(['fi','ru']) &&
         d.fi is string && d.fi.size() > 0 && d.fi.size() <= 300 &&
         d.ru is string && d.ru.size() > 0 && d.ru.size() <= 300)
      );
    }
    function validEvent(uid,eventId) {
      return request.resource.data.keys().hasOnly([
               'v','uid','id','device','kind','target','time','data'
             ]) &&
             request.resource.data.keys().hasAll([
               'v','uid','id','device','kind','target','time','data'
             ]) &&
             request.resource.data.v == 3 &&
             request.resource.data.uid == uid &&
             request.resource.data.id == eventId &&
             eventId.matches('^E_[a-f0-9]{32}$') &&
             request.resource.data.device is string &&
             request.resource.data.device.matches('^D_[a-f0-9]{32}$') &&
             request.resource.data.target is string &&
             request.resource.data.target.size() > 0 &&
             request.resource.data.target.size() <= 180 &&
             request.resource.data.time is int &&
             request.resource.data.data is map &&
             request.resource.data.kind in [
               'answer','learned_set','favorite_set','word_upsert','word_delete',
               'collection_set'
             ] &&
             validPayload();
    }
    // Append-only private per-user events.
    match /sync_v3/{uid}/events/{eventId} {
      allow get, list: if v3Owner(uid);
      allow create: if v3Owner(uid) && validEvent(uid,eventId);
      // Safe idempotent retries must not be able to alter the event body.
      allow update: if false;
      allow delete: if false;
    }
    // One-time per-user verified import baseline; immutable after creation.
    match /sync_v3/{uid}/state/baseline {
      allow get: if v3Owner(uid);
      allow list: if false;
      allow create: if v3Owner(uid)
        && request.resource.data.keys().hasOnly([
             'v','uid','migrationId','importedAt','sha256','source','snapshot'
           ])
        && request.resource.data.keys().hasAll([
             'v','uid','migrationId','importedAt','sha256','source','snapshot'
           ])
        && request.resource.data.v == 3
        && request.resource.data.uid == uid
        && request.resource.data.migrationId is string
        && request.resource.data.migrationId.size() > 0
        && request.resource.data.migrationId.size() <= 180
        && request.resource.data.importedAt is int
        && request.resource.data.sha256 is string
        && request.resource.data.sha256.matches('^[a-f0-9]{64}$')
        && request.resource.data.source == 'approved-local-JSON'
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.keys().hasAll([
             'scores','words','favorites'
           ]);
      allow update, delete: if false;
    }
    // Reserved separate collection; never permit client updates here yet.
    match /sync_v3/{uid}/words/{wordId} {
      allow get, list: if v3Owner(uid);
      allow create, update, delete: if false;
    }
    match /libraries/{libraryId} {
      allow get, list: if loggedIn() && (resource.data.visibility == 'public' || resource.data.ownerUid == request.auth.uid);
      allow create: if loggedIn() && libraryId.matches(request.auth.uid + '_[A-Za-z0-9]+') && verified() && validLibrary();
      allow update: if loggedIn() && resource.data.ownerUid == request.auth.uid && verified() && validLibrary();
      allow delete: if loggedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // V3 ADMIN: only one read-only aggregate, only for a verified Google admin.
    // The admin claim must be issued separately by a trusted backend.
    match /admin_metrics/{metricId} {
      allow get: if metricId == 'current'
        && verified()
        && request.auth.token.admin == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
